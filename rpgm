#!/bin/sh
set -eu

VERSION=0.5.0
self=$(readlink -f "$0")
here=$(dirname "$self")/lib

die() { printf 'rpgm: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
node_js() {
	if have node; then node "$@"
	elif have electron; then ELECTRON_RUN_AS_NODE=1 electron "$@"
	else die "this needs electron (apk add electron) or node"
	fi
}
find_ci() { (cd "$game" && find . -maxdepth 3 -ipath "./$1" 2>/dev/null | head -n 1 | cut -c3-); }
has() { [ -n "$(find_ci "$1")" ]; }
evb_exe() {
	for f in "$game"/*.[eE][xX][eE]; do
		[ -f "$f" ] && head -c 4096 "$f" | tr '\000' '\n' | grep -qF .enigma1 && { echo "$f"; return 0; }
	done
	return 1
}

usage() {
	cat <<EOF
Usage: rpgm [-t | -e | -i | -s] [GAME_DIR | GAME.exe]
       rpgm --edit-save SAVE_FILE

Runs a Windows RPG Maker game natively (default: the current directory).

  -t, --test      playtest mode (F9 debug menu, F12 devtools)
  -e, --editor    MV/MZ: F8 opens an editor for gold, items, actors, switches
  -w, --wasd      MV/MZ: WASD moves, E confirms, Q cancels
  -i, --info      show what was detected
  -s, --setup     XP/VX/VX Ace: write an mkxp.json that loads the shims
  --edit-save     MV/MZ: open a save as JSON in \$EDITOR, write it back on exit
  -h, --help      show this help
  -V, --version   show the version

Environment: RPGM_PLATFORM (wayland or x11), RPGM_RGSS_SKIP (shims to leave
out), RPGM_MKXPZ_PRELOAD (mkxp-z's scripts/preload, if not found).
EOF
}

mode=run test='' editor='' wasd=''
while [ $# -gt 0 ]; do
	case $1 in
	-t | --test) test=1 ;;
	-e | --editor) editor=1 ;;
	-w | --wasd) wasd=1 ;;
	-i | --info) mode=info ;;
	-s | --setup) mode=setup ;;
	--edit-save) mode=edit-save ;;
	-h | --help) usage; exit 0 ;;
	-V | --version) echo "rpgm $VERSION"; exit 0 ;;
	--) shift; break ;;
	-*) die "unknown option $1 (see --help)" ;;
	*) break ;;
	esac
	shift
done
[ $# -le 1 ] || die "expected one game path (see --help)"
target=${1:-.}
[ -e "$target" ] || die "no such file or directory: $target"

if [ "$mode" = edit-save ]; then
	[ -f "$target" ] || die "--edit-save takes a save file, e.g. www/save/file1.rpgsave"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT INT TERM
	node_js "$here/savejson.js" decode "$target" "$tmp/save.json" || exit 1
	cp "$tmp/save.json" "$tmp/before.json"
	# shellcheck disable=SC2086
	${EDITOR:-vi} "$tmp/save.json"
	if cmp -s "$tmp/save.json" "$tmp/before.json"; then echo "Unchanged; nothing written."; exit 0; fi
	if ! node_js "$here/savejson.js" encode "$tmp/save.json" "$target"; then
		cp "$tmp/save.json" "$target.json"
		die "not written; your edit is kept in $target.json"
	fi
	echo "Wrote $target (the original is kept as $target.bak)"
	exit 0
fi
[ -d "$target" ] || target=$(dirname "$target")
game=$(cd "$target" && pwd -P)
unpacked="${XDG_DATA_HOME:-$HOME/.local/share}/rpgm/unpacked/$(printf %s "$game" | md5sum | cut -c1-12)"

if has www/js/rpg_core.js || has js/rpg_core.js; then engine='mv'
elif has js/rmmz_core.js; then engine='mz'
elif has package.json; then engine='nwjs'
elif has package.nw; then engine='nwjs-zip'
elif has resources/app.asar || has resources/app/package.json; then engine='electron-app'
elif has 'data/*.r?data*' || { has game.ini && has 'game.rgss*'; }; then engine='rgss'
elif packed=$(evb_exe); then engine='evb'
else engine=
fi

mkxp_preload_dir() {
	[ -z "${RPGM_MKXPZ_PRELOAD:-}" ] || { echo "$RPGM_MKXPZ_PRELOAD"; return 0; }
	m=$(command -v mkxp-z 2>/dev/null) || return 1
	m=$(dirname "$(readlink -f "$m")")
	for p in "$m/../lib/mkxp-z/scripts/preload" "$m/scripts/preload"; do
		[ -f "$p/win32_wrap.rb" ] && { (cd "$p" && pwd -P); return 0; }
	done
	return 1
}

case $mode in
info)
	echo "rpgm:    $VERSION"
	echo "game:    $game"
	echo "engine:  ${engine:-not recognized}"
	core=$(find_ci www/js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rmmz_core.js)
	[ -z "$core" ] || sed -n "s/^Utils\.RPGMAKER_VERSION *= *.\([0-9.]*\).*/version: \1/p" "$game/$core"
	case $engine in
	'') ;;
	evb) echo "packed:  $(basename "$packed") (Enigma Virtual Box), unpacked on first run to $unpacked" ;;
	rgss)
		if have mkxp-z; then echo "runtime: $(command -v mkxp-z)"; else echo "runtime: mkxp-z not installed (./build-mkxp-z.sh)"; fi
		if [ -n "$(find_ci mkxp.json)" ]; then echo "config:  $(find_ci mkxp.json)"; else echo "config:  none (rpgm --setup writes one)"; fi ;;
	*)
		if have electron; then echo "runtime: $(command -v electron)"; else echo "runtime: electron not installed (apk add electron)"; fi ;;
	esac
	exit 0 ;;
setup)
	[ "$engine" = rgss ] || die "--setup is for RPG Maker XP/VX/VX Ace games; this is ${engine:-not recognized}"
	keys="\"preloadScript\": [\"$here/rgss/all.rb\"],
	\"enableReset\": false"
	if [ -n "$(find_ci mkxp.json)" ]; then
		printf '%s already exists; add these keys to it:\n\t%s\n' "$game/$(find_ci mkxp.json)" "$keys"
		exit 0
	fi
	printf '{\n\t%s\n}\n' "$keys" >"$game/mkxp.json" || die "cannot write $game/mkxp.json"
	echo "Wrote $game/mkxp.json"
	exit 0 ;;
esac

case ${RPGM_PLATFORM:-} in
wayland | x11) flags="--ozone-platform=$RPGM_PLATFORM" ;;
'') if [ -n "${WAYLAND_DISPLAY:-}" ]; then flags=--ozone-platform=wayland; else flags=--ozone-platform=x11; fi ;;
*) die "RPGM_PLATFORM must be wayland or x11" ;;
esac
[ "$(id -u)" != 0 ] || flags="$flags --no-sandbox"
# shellcheck disable=SC3045
ulimit -n "$(ulimit -H -n)" 2>/dev/null || true

run_electron() {
	have electron || die "electron is not installed (apk add electron, Alpine edge testing)"
	win="${XDG_DATA_HOME:-$HOME/.local/share}/rpgm/windows"
	export USERPROFILE="${USERPROFILE:-$win}" APPDATA="${APPDATA:-$win/AppData/Roaming}" LOCALAPPDATA="${LOCALAPPDATA:-$win/AppData/Local}"
	mkdir -p "$USERPROFILE" "$APPDATA" "$LOCALAPPDATA" || die "cannot create $win"
	# shellcheck disable=SC2086
	exec electron $flags "$@"
}

case $engine in
mv | mz | nwjs)
	export RPGM_GAME="$game" RPGM_TEST="$test" RPGM_EDITOR="$editor" RPGM_WASD="$wasd"
	run_electron "$here" ;;
nwjs-zip | evb)
	[ "$engine" = evb ] || packed="$game/$(find_ci package.nw)"
	if [ ! -f "$unpacked/.rpgm-unpacked" ] || [ -n "$(find "$packed" -newer "$unpacked/.rpgm-unpacked")" ]; then
		mkdir -p "$unpacked" || die "cannot create $unpacked"
		node_js "$here/evb.js" "$packed" "$unpacked" || exit 1
		touch "$unpacked/.rpgm-unpacked"
	fi
	exec sh "$self" ${test:+--test} ${editor:+--editor} ${wasd:+--wasd} "$unpacked" ;;
electron-app)
	app="$game/$(find_ci resources/app.asar)"
	[ -f "$app" ] || app="$game/$(find_ci resources/app)"
	run_electron "$app" ;;
rgss)
	have mkxp-z || die "XP/VX/VX Ace games need mkxp-z (./build-mkxp-z.sh builds it)"
	[ -n "$(find_ci mkxp.json)" ] || echo "rpgm: no mkxp.json; 'rpgm --setup \"$game\"' writes one that loads the shims" >&2
	cd "$game"
	pre=$(mkxp_preload_dir || true)
	[ -z "$pre" ] || export RPGM_MKXPZ_PRELOAD="$pre"
	case $(find_ci 'data/scripts.r*data*' | tr '[:upper:]' '[:lower:]') in
	*.rxdata) rgss=1 ;; *.rvdata) rgss=2 ;; *) rgss=3 ;;
	esac
	export SRCDIR="$game" RPGM_SHIM_DIR="$here/rgss" RPGM_RGSS_VERSION="$rgss"
	if [ -n "$test" ]; then exec mkxp-z test; else exec mkxp-z; fi ;;
*) die "no RPG Maker game found in $game" ;;
esac
