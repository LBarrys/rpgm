#!/bin/sh
set -eu

VERSION=0.7.0
self=$(readlink -f "$0")
here=$(dirname "$self")/lib

die() { printf 'rpgm: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
node_js() {
	if have node; then node "$@"
	elif have electron; then ELECTRON_RUN_AS_NODE=1 electron "$@"
	else die "this needs electron (apk add electron) or node"
	fi
}
ci_glob() { printf '%s\n' "$1" | awk '{ for (i = 1; i <= length($0); i++) { c = substr($0, i, 1); u = toupper(c); l = tolower(c); printf "%s", (u != l ? "[" l u "]" : c) } }'; }
find_ci() {
	# shellcheck disable=SC2046
	for f in "$game"/$(ci_glob "$1"); do
		[ -e "$f" ] && { printf '%s\n' "${f#"$game"/}"; return 0; }
	done
	return 0
}
has() { [ -n "$(find_ci "$1")" ]; }
evb_exe() {
	for f in "$game"/*.[eE][xX][eE]; do
		[ -f "$f" ] && head -c 4096 "$f" | tr '\000' '\n' | grep -qF .enigma1 && { echo "$f"; return 0; }
	done
	return 1
}

usage() {
	cat <<EOF
Usage: rpgm [-T | -c | -w | -t FILE | -i] [GAME_DIR | GAME.exe]
       rpgm -e SAVE_FILE

Runs a Windows RPG Maker game natively (default: the current directory).

  -T, --test      playtest mode (F9 debug menu, F12 devtools)
  -c, --cheat     F8 opens a cheat menu (MV/MZ/XP/VX/VX Ace)
  -w, --wasd      MV/MZ: WASD moves, E confirms, Q cancels
  -t, --translate FILE  show FILE's translations ({"text": "translation"});
                  new text is added to it with an empty translation
  -i, --info      show what was detected
  -e, --edit-save MV/MZ: open a save as JSON in \$EDITOR, write it back on exit
  -h, --help      show this help
  -V, --version   show the version

Games run on Wayland only. RTPs go in ~/.local/share/rpgm/rtp/ (RPG Maker
2000/2003: RPG2000, RPG2003; XP: Standard; VX: RPGVX; VX Ace: RPGVXAce).
Environment: RPGM_RGSS_SKIP (shims to leave out), RPGM_MKXPZ_PRELOAD
(mkxp-z's scripts/preload, if not found).
EOF
}

mode=run test='' cheat='' wasd='' translate=''
while [ $# -gt 0 ]; do
	case $1 in
	-T | --test) test=1 ;;
	-c | --cheat) cheat=1 ;;
	-w | --wasd) wasd=1 ;;
	-t | --translate)
		[ $# -ge 2 ] || die "--translate needs a file"
		[ ! -d "$2" ] || die "--translate takes a JSON file, not a folder (playtest is -T)"
		translate=$2; shift ;;
	-i | --info) mode=info ;;
	-e | --edit-save) mode=edit-save ;;
	-h | --help) usage; exit 0 ;;
	-V | --version) echo "rpgm $VERSION"; exit 0 ;;
	--) shift; break ;;
	-*) die "unknown option $1 (see --help)" ;;
	*) break ;;
	esac
	shift
done
[ $# -le 1 ] || die "expected one game path (see --help)"
target=${1:-.}
[ -e "$target" ] || die "no such file or directory: $target"

if [ "$mode" = edit-save ]; then
	[ -f "$target" ] || die "--edit-save takes a save file, e.g. www/save/file1.rpgsave"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT INT TERM
	node_js "$here/savejson.js" decode "$target" "$tmp/save.json" || exit 1
	cp "$tmp/save.json" "$tmp/before.json"
	# shellcheck disable=SC2086
	${EDITOR:-vi} "$tmp/save.json"
	if cmp -s "$tmp/save.json" "$tmp/before.json"; then echo "Unchanged; nothing written."; exit 0; fi
	if ! node_js "$here/savejson.js" encode "$tmp/save.json" "$target"; then
		cp "$tmp/save.json" "$target.json"
		die "not written; your edit is kept in $target.json"
	fi
	echo "Wrote $target (the original is kept as $target.bak)"
	exit 0
fi
[ -d "$target" ] || target=$(dirname "$target")
game=$(cd "$target" && pwd -P)
data="${XDG_DATA_HOME:-$HOME/.local/share}/rpgm"
id=$(printf %s "$game" | md5sum | cut -c1-12)
unpacked="$data/unpacked/$id"
rtp="$data/rtp"

if has www/js/rpg_core.js || has js/rpg_core.js; then engine='mv'
elif has js/rmmz_core.js; then engine='mz'
elif has package.json; then engine='nwjs'
elif has package.nw; then engine='nwjs-zip'
elif has resources/app.asar || has resources/app/package.json; then engine='electron-app'
elif has 'data/*.r?data*' || { has game.ini && has 'game.rgss*'; }; then engine='rgss'
elif has rpg_rt.ldb && has rpg_rt.lmt; then engine='rm2k'
elif packed=$(evb_exe); then engine='evb'
else engine=
fi

mkxp_preload_dir() {
	[ -z "${RPGM_MKXPZ_PRELOAD:-}" ] || { echo "$RPGM_MKXPZ_PRELOAD"; return 0; }
	m=$(command -v mkxp-z 2>/dev/null) || return 1
	m=$(dirname "$(readlink -f "$m")")
	for p in "$m/../lib/mkxp-z/scripts/preload" "$m/scripts/preload"; do
		[ -f "$p/win32_wrap.rb" ] && { (cd "$p" && pwd -P); return 0; }
	done
	return 1
}
rtp_names() {
	ini=$(find_ci game.ini)
	[ -z "$ini" ] || tr -d '\r' <"$game/$ini" | sed -n 's/^RTP[1-3]\{0,1\} *= *\(..*\)$/\1/p'
}
json() { printf '"%s"' "$(printf %s "$1" | sed 's/[\\"]/\\&/g')"; }

case $mode in
info)
	echo "rpgm:    $VERSION"
	echo "game:    $game"
	echo "engine:  ${engine:-not recognized}"
	core=$(find_ci www/js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rmmz_core.js)
	[ -z "$core" ] || sed -n "s/^Utils\.RPGMAKER_VERSION *= *.\([0-9.]*\).*/version: \1/p" "$game/$core"
	case $engine in
	'') ;;
	evb) echo "packed:  $(basename "$packed") (Enigma Virtual Box), unpacked on first run to $unpacked" ;;
	rgss)
		if have mkxp-z; then echo "runtime: $(command -v mkxp-z)"; else echo "runtime: mkxp-z not installed (./build-mkxp-z.sh)"; fi
		echo "config:  written by rpgm to $data/mkxp/$id"
		[ -z "$(find_ci mkxp.json)" ] || echo "         merged with the game's $(find_ci mkxp.json)"
		rtp_names | while read -r name; do
			if [ -d "$rtp/$name" ]; then echo "rtp:     $name, installed"; else echo "rtp:     $name, not installed in $rtp/$name"; fi
		done ;;
	rm2k)
		if have easyrpg-player; then echo "runtime: $(command -v easyrpg-player)"; else echo "runtime: easyrpg-player not installed (apk add easyrpg-player)"; fi
		echo "rtp:     $rtp/RPG2000 and $rtp/RPG2003, if the game needs one" ;;
	*)
		if have electron; then echo "runtime: $(command -v electron)"; else echo "runtime: electron not installed (apk add electron)"; fi ;;
	esac
	exit 0 ;;
esac

[ -n "${WAYLAND_DISPLAY:-}" ] || die "rpgm runs games on Wayland only, and WAYLAND_DISPLAY is not set"
if [ -n "$translate" ]; then
	tdir=$(cd "$(dirname "$translate")" 2>/dev/null && pwd -P) || die "no such folder for $translate"
	translate="$tdir/$(basename "$translate")"
	[ -e "$translate" ] || printf '{}\n' >"$translate" || die "cannot create $translate"
	case $engine in electron-app | rm2k) echo "rpgm: --translate works for RPG Maker MV/MZ/XP/VX/VX Ace games only" >&2 ;; esac
fi
flags='--ozone-platform=wayland --enable-features=WaylandWindowDecorations'
[ "$(id -u)" != 0 ] || flags="$flags --no-sandbox"
# shellcheck disable=SC3045
ulimit -n "$(ulimit -H -n)" 2>/dev/null || true

run_electron() {
	have electron || die "electron is not installed (apk add electron, Alpine edge testing)"
	win="${XDG_DATA_HOME:-$HOME/.local/share}/rpgm/windows"
	export USERPROFILE="${USERPROFILE:-$win}" APPDATA="${APPDATA:-$win/AppData/Roaming}" LOCALAPPDATA="${LOCALAPPDATA:-$win/AppData/Local}"
	mkdir -p "$USERPROFILE" "$APPDATA" "$LOCALAPPDATA" || die "cannot create $win"
	# shellcheck disable=SC2086
	exec electron $flags "$@"
}

case $engine in
mv | mz | nwjs)
	export RPGM_GAME="$game" RPGM_TEST="$test" RPGM_CHEAT="$cheat" RPGM_WASD="$wasd" RPGM_TRANSLATE="$translate"
	run_electron "$here" ;;
nwjs-zip | evb)
	[ "$engine" = evb ] || packed="$game/$(find_ci package.nw)"
	if [ ! -f "$unpacked/.rpgm-unpacked" ] || [ -n "$(find "$packed" -newer "$unpacked/.rpgm-unpacked")" ]; then
		mkdir -p "$unpacked" || die "cannot create $unpacked"
		node_js "$here/evb.js" "$packed" "$unpacked" || exit 1
		touch "$unpacked/.rpgm-unpacked"
	fi
	exec sh "$self" ${test:+--test} ${cheat:+--cheat} ${wasd:+--wasd} ${translate:+--translate "$translate"} "$unpacked" ;;
electron-app)
	app="$game/$(find_ci resources/app.asar)"
	[ -f "$app" ] || app="$game/$(find_ci resources/app)"
	run_electron "$app" ;;
rgss)
	have mkxp-z || die "XP/VX/VX Ace games need mkxp-z (./build-mkxp-z.sh builds it)"
	pre=$(mkxp_preload_dir || true)
	[ -z "$pre" ] || export RPGM_MKXPZ_PRELOAD="$pre"
	scripts=$(find_ci 'data/scripts.r*data*')
	[ -n "$scripts" ] || scripts=$(find_ci 'game.rgss*')
	case $(printf %s "$scripts" | tr '[:upper:]' '[:lower:]') in
	*.rxdata | *.rgssad) rgss=1 ;; *.rvdata | *.rgss2a) rgss=2 ;; *) rgss=3 ;;
	esac
	conf="$data/mkxp/$id"
	mkdir -p "$conf" || die "cannot create $conf"
	paths=''
	for name in $(rtp_names); do
		if [ -d "$rtp/$name" ]; then paths="$paths${paths:+, }$(json "$rtp/$name")"
		else echo "rpgm: the game names the $name RTP; if graphics or sounds are missing, extract it to $rtp/$name" >&2
		fi
	done
	lib=''
	[ -z "$pre" ] || [ ! -d "$pre/../../stdlib" ] || lib=$(json "$(cd "$pre/../../stdlib" && pwd -P)")
	keys="\"gameFolder\": $(json "$game"), \"preloadScript\": [$(json "$here/rgss/all.rb")], \"enableReset\": false, \"RTP\": [$paths], \"rubyLoadpath\": [$lib]"
	own=$(find_ci mkxp.json)
	if [ -n "$own" ] && K="$keys," awk '!done && /^[ \t]*\{/ { i = index($0, "{"); $0 = substr($0, 1, i) " " ENVIRON["K"] substr($0, i + 1); done = 1 } { print } END { exit !done }' "$game/$own" >"$conf/mkxp.json"; then
		! grep -v '^[[:space:]]*//' "$game/$own" | grep -q '"preloadScript"' || echo "rpgm: $own sets its own preloadScript, so rpgm's fixes are left out" >&2
	else
		[ -z "$own" ] || echo "rpgm: cannot read $own; its settings are left out" >&2
		printf '{\n\t%s\n}\n' "$keys" >"$conf/mkxp.json" || die "cannot write $conf/mkxp.json"
	fi
	cd "$conf"
	export SDL_VIDEODRIVER=wayland SRCDIR="$game" RPGM_SHIM_DIR="$here/rgss" RPGM_RGSS_VERSION="$rgss" RPGM_CHEAT="$cheat" RPGM_TRANSLATE="$translate"
	if [ -n "$test" ]; then exec mkxp-z test; else exec mkxp-z; fi ;;
rm2k)
	have easyrpg-player || die "RPG Maker 2000/2003 games need easyrpg-player (apk add easyrpg-player)"
	[ -n "${RPG2K_RTP_PATH:-}" ] || [ ! -d "$rtp/RPG2000" ] || export RPG2K_RTP_PATH="$rtp/RPG2000"
	[ -n "${RPG2K3_RTP_PATH:-}" ] || [ ! -d "$rtp/RPG2003" ] || export RPG2K3_RTP_PATH="$rtp/RPG2003"
	export SDL_VIDEODRIVER=wayland SDL_VIDEO_DRIVER=wayland
	exec easyrpg-player --project-path "$game" ${test:+--test-play} ;;
*) die "no RPG Maker game found in $game" ;;
esac
